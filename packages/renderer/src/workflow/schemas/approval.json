{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "节点名称",
      "x-group": "基础属性",
      "x-priority": 1
    },
    "approvalMode": {
      "type": "string",
      "title": "审批模式",
      "enum": ["single", "countersign", "orSign", "raceSign"],
      "x-component": "select",
      "x-group": "基础属性",
      "x-priority": 2,
      "x-component-props": {
        "options": [
          { "label": "单人审批", "value": "single" },
          { "label": "会签（所有人同意）", "value": "countersign" },
          { "label": "或签（一人同意即可）", "value": "orSign" },
          { "label": "竞签（先到先得）", "value": "raceSign" }
        ]
      }
    },
    "assignee": {
      "type": "string",
      "title": "审批人",
      "x-component": "user-select",
      "x-group": "基础属性",
      "x-priority": 3,
      "x-component-props": {
        "mode": "single",
        "placeholder": "选择审批人"
      }
    },
    "candidateUsers": {
      "type": "array",
      "title": "候选用户",
      "x-component": "user-select",
      "x-group": "基础属性",
      "x-priority": 4,
      "x-component-props": {
        "mode": "multiple",
        "placeholder": "选择候选用户"
      }
    },
    "candidateGroups": {
      "type": "array",
      "title": "候选角色组",
      "x-component": "role-select",
      "x-group": "基础属性",
      "x-priority": 5,
      "x-component-props": {
        "mode": "multiple"
      }
    },
    "rejectAction": {
      "type": "string",
      "title": "驳回动作",
      "enum": ["rejectToStart", "rejectToPrevious", "rejectToEnd"],
      "x-component": "select",
      "x-group": "高级属性",
      "x-priority": 1,
      "x-component-props": {
        "options": [
          { "label": "驳回到发起人", "value": "rejectToStart" },
          { "label": "驳回到上一节点", "value": "rejectToPrevious" },
          { "label": "直接结束", "value": "rejectToEnd" }
        ]
      }
    },
    "dueDate": {
      "type": "string",
      "title": "截止时间",
      "format": "date-time",
      "x-group": "高级属性",
      "x-priority": 2
    },
    "pagePermissions": {
      "type": "object",
      "title": "页面权限配置",
      "x-group": "页面权限",
      "x-priority": 1,
      "x-component": "permission-matrix",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "启用页面权限"
        },
        "components": {
          "type": "object",
          "title": "组件权限",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "permission": {
                "type": "string",
                "enum": ["readonly", "editable", "hidden"]
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}

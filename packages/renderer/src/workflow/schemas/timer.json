{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "节点名称",
      "x-group": "基础属性",
      "x-priority": 1
    },
    "timerType": {
      "type": "string",
      "title": "延时类型",
      "enum": ["duration", "datetime"],
      "x-component": "select",
      "x-group": "基础属性",
      "x-priority": 2,
      "x-component-props": {
        "options": [
          { "label": "固定时长", "value": "duration" },
          { "label": "指定时间", "value": "datetime" }
        ]
      }
    },
    "duration": {
      "type": "number",
      "title": "延时（分钟）",
      "x-group": "基础属性",
      "x-priority": 3,
      "x-visible": "${timerType === 'duration'}",
      "x-component-props": {
        "min": 1
      }
    },
    "executeAt": {
      "type": "string",
      "title": "执行时间",
      "format": "date-time",
      "x-group": "基础属性",
      "x-priority": 4,
      "x-visible": "${timerType === 'datetime'}"
    }
  }
}
